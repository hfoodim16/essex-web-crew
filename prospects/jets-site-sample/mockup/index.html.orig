<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>New York Jets | Tickets, Packages &amp; Training Camp</title>
<meta name="description" content="Pre-season, three-game and full-season tickets for the New York Jets, plus free access to training camp. 56 years of football. Super Bowl winner, 1969.">
<link rel="canonical" href="PLACEHOLDER_DOMAIN">

<meta property="og:type" content="website">
<meta property="og:site_name" content="New York Jets">
<meta property="og:title" content="New York Jets | Tickets, Packages &amp; Training Camp">
<meta property="og:description" content="Pre-season, three-game and full-season tickets, plus free access to training camp. 56 years of football. Super Bowl winner, 1969.">
<meta property="og:image" content="assets/og-image.webp">
<meta property="og:url" content="PLACEHOLDER_DOMAIN">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="New York Jets | Tickets, Packages &amp; Training Camp">
<meta name="twitter:description" content="Pre-season, three-game and full-season tickets, plus free access to training camp. 56 years of football.">
<meta name="twitter:image" content="assets/og-image.webp">
<meta name="theme-color" content="#0A1F14">

<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%230A1F14'/%3E%3Ctext x='32' y='45' font-family='Verdana,sans-serif' font-size='30' font-weight='700' text-anchor='middle' fill='%231F7A4D'%3ENY%3C/text%3E%3C/svg%3E">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders:opsz,wght@10..72,100..900&family=Chivo:ital,wght@0,300..900;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SportsTeam",
  "name": "New York Jets",
  "sport": "American Football",
  "url": "PLACEHOLDER_DOMAIN",
  "logo": "assets/ny-jets-logo.svg",
  "image": "assets/og-image.webp",
  "award": "Super Bowl winner, 1969",
  "contactPoint": [{
    "@type": "ContactPoint",
    "contactType": "Tickets",
    "telephone": "PLACEHOLDER_TICKET_LINE",
    "email": "PLACEHOLDER_TICKET_EMAIL"
  }]
}
</script>

<!--
  Fail-visible boot. This arms the entrance states ONLY when scripting is live,
  and a dead-man's timer disarms them if main.js never runs. Nothing on this page
  is hidden in style.css: with JS off, or main.js missing, the page reads in full.
-->
<script>
(function () {
  var d = document.documentElement;
  d.classList.add('js');
  window.__jetsFailsafe = window.setTimeout(function () {
    d.classList.remove('js');
  }, 1200);
})();
</script>
</head>

<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header" id="top">
  <div class="header-inner">
    <a class="brand" href="#top" aria-label="New York Jets, back to top">
      <img class="brand-mark" src="assets/ny-jets-logo.svg" alt="New York Jets logo" width="296" height="177">
    </a>

    <nav class="nav" id="nav" aria-label="Primary">
      <ul class="nav-list" role="list">
        <li><a class="nav-link" href="#tickets">Tickets</a></li>
        <li><a class="nav-link" href="#story">Story</a></li>
        <li><a class="nav-link" href="#players">Players</a></li>
        <li><a class="nav-link" href="#charity">Charity</a></li>
        <li><a class="nav-link" href="#contact">Contact</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a class="btn btn-primary header-cta" href="PLACEHOLDER_TICKET_URL">
        <span>Get Tickets</span><span class="btn-arrow" aria-hidden="true">&#8594;</span>
      </a>
      <button class="hamburger" id="hamburger" type="button" aria-controls="nav" aria-expanded="false" aria-label="Open menu">
        <span class="hamburger-bar" aria-hidden="true"></span>
        <span class="hamburger-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<main id="main">

  <!-- 1. HERO — the "Lights On" film. One continuous 25-second shot of the
       stadium's floodlight banks coming on, scrubbed by scroll on a canvas.
       Fail-visible like everything else on this page: with scripting dead or
       reduced motion on, this section is a static poster with all of its copy
       in normal flow — film.js only upgrades it. -->
  <section class="film" aria-labelledby="hero-title">
    <div class="film-stage">
      <img class="film-poster" src="assets/film-poster.jpg" alt="An empty stadium at night, floodlights off, a single chalk-white yard line running toward midfield." width="1280" height="720" fetchpriority="high" decoding="async">
      <canvas class="film-canvas" aria-hidden="true"></canvas>

      <div class="beat beat-hero" data-in="-0.1" data-peak="0" data-out="0.2">
        <div class="container">
          <h1 class="hero-title rise" id="hero-title">Green and white,<br>wherever the fans are.</h1>
          <a class="btn btn-primary btn-lg rise" style="--i:1" href="PLACEHOLDER_TICKET_URL">
            <span>Get Tickets</span><span class="btn-arrow" aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </div>

      <div class="beat beat-mid beat-years" data-in="0.3" data-peak="0.41" data-out="0.52">
        <p class="beat-line">56 years of football.</p>
      </div>

      <div class="beat beat-mid beat-serve" data-in="0.58" data-peak="0.69" data-out="0.8">
        <p class="beat-line">Serving the fans what they cheer for.</p>
      </div>

      <div class="beat beat-finale" data-in="0.85" data-peak="0.94" data-out="2">
        <img class="finale-mark" src="assets/ny-jets-logo.svg" alt="" width="296" height="177">
        <p class="finale-sub">Pre-season, three-game and full-season tickets, plus free access to training camp.</p>
        <a class="btn btn-primary btn-lg" href="PLACEHOLDER_TICKET_URL">
          <span>Get Tickets</span><span class="btn-arrow" aria-hidden="true">&#8594;</span>
        </a>
      </div>

      <div class="film-fade" aria-hidden="true"></div>
    </div>
  </section>

  <!-- 2. TRUST STRIP — real, client-given facts only -->
  <section class="strip" aria-label="Club facts">
    <div class="container strip-inner">
      <p class="strip-item rise">Super Bowl winner, 1969</p>
      <p class="strip-item rise" style="--i:1">56 years of football</p>
      <p class="strip-item rise" style="--i:2">Green and white</p>
    </div>
  </section>

  <!-- 3. TICKETS — the services section. Content is exactly the Q8 list, nothing added. -->
  <section class="tickets" id="tickets" aria-labelledby="tickets-title">
    <div class="container">
      <div class="section-head">
        <span class="rule" aria-hidden="true"></span>
        <h2 class="section-title rise" id="tickets-title">Tickets</h2>
        <p class="section-lead rise" style="--i:1">Serving the fans what they cheer for.</p>
      </div>

      <div class="tiles" role="list">
        <article class="tile tile-a rise" role="listitem">
          <span class="tile-ground" aria-hidden="true"></span>
          <div class="tile-body">
            <h3 class="tile-title">Pre-season</h3>
            <p class="tile-text">Single-game tickets, before the regular season starts.</p>
            <a class="tile-cta" href="PLACEHOLDER_TICKET_URL">
              <span>Get Tickets</span><span class="btn-arrow" aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </article>

        <article class="tile tile-b rise" style="--i:1" role="listitem">
          <span class="tile-ground" aria-hidden="true"></span>
          <div class="tile-body">
            <h3 class="tile-title">Three games</h3>
            <p class="tile-text">Pick up three games as one package.</p>
            <a class="tile-cta" href="PLACEHOLDER_TICKET_URL">
              <span>Get Tickets</span><span class="btn-arrow" aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </article>

        <article class="tile tile-c rise" style="--i:2" role="listitem">
          <span class="tile-ground" aria-hidden="true"></span>
          <div class="tile-body">
            <h3 class="tile-title">Full season</h3>
            <p class="tile-text">Every game on one set of tickets. This is what our season-ticket families hold.</p>
            <a class="tile-cta" href="PLACEHOLDER_TICKET_URL">
              <span>Get Tickets</span><span class="btn-arrow" aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </article>
      </div>

      <div class="highlight rise">
        <p class="highlight-lead">Access to training camp is free.</p>
        <p class="highlight-note">Dates and location: PLACEHOLDER_TRAINING_CAMP_DETAIL</p>
      </div>

      <p class="tickets-foot rise">Most people find us through Ticketmaster and StubHub.</p>
    </div>
  </section>

  <!-- 4. HERITAGE BAND — the one scroll set-piece: the 1969 numerals resolve on scrub. -->
  <section class="heritage" aria-labelledby="heritage-title">
    <div class="heritage-media">
      <img src="assets/heritage-turf-ball.webp" alt="A worn leather football resting on stadium grass beside a white chalk yard line in low evening sun." width="1920" height="1072" loading="lazy" decoding="async">
    </div>
    <div class="heritage-scrim" aria-hidden="true"></div>

    <div class="container heritage-inner">
      <p class="heritage-num" aria-hidden="true">1969</p>
      <h2 class="heritage-title" id="heritage-title">Super Bowl winner, 1969</h2>
      <p class="heritage-text">56 years of football. One Super Bowl.</p>
    </div>
  </section>

  <!-- 5. STORY — organizational voice, then the ONE lyrical block in the owner's own words -->
  <section class="story" id="story" aria-labelledby="story-title">
    <div class="container story-grid">
      <div class="story-col">
        <span class="rule" aria-hidden="true"></span>
        <h2 class="section-title rise" id="story-title">The club</h2>
        <p class="story-text rise" style="--i:1">The New York Jets have been playing for 56 years, in green and white, with one Super Bowl to the club's name: 1969.</p>
        <p class="story-text rise" style="--i:2">The current owner came to the club from a career in finance.</p>
      </div>

      <!-- Attribution name: Harry to supply. The client gave no owner name in their
           answers, so none is written here. Do not invent one. -->
      <figure class="quote rise" style="--i:1">
        <blockquote class="quote-text">
          <p>&ldquo;As a kid I always wanted to own an NFL team. After working in finance, I had the money to finally fulfill that goal.&rdquo;</p>
          <p>&ldquo;I am willing to eat losses in order for the team to be better.&rdquo;</p>
        </blockquote>
        <figcaption class="quote-cite">Team Owner, New York Jets</figcaption>
      </figure>
    </div>
  </section>

  <!-- 6. PLAYERS — no names, no numbers, no positions. Labeled club-supplied slots only. -->
  <section class="players" id="players" aria-labelledby="players-title">
    <div class="container">
      <div class="section-head">
        <span class="rule" aria-hidden="true"></span>
        <h2 class="section-title rise" id="players-title">Players</h2>
        <p class="section-lead rise" style="--i:1">The club supplies the photos and names for this section.</p>
      </div>

      <div class="player-grid" role="list">
        <!-- AI-IMAGE: none. This slot is for a REAL club player photograph, 3:4 portrait. -->
        <div class="player-cell rise" role="listitem">
          <div class="img-placeholder ratio-3x4" role="img" aria-label="Player photo, supplied by the club">
            <span>Player photo + name &mdash; supplied by the club</span>
          </div>
        </div>
        <!-- AI-IMAGE: none. This slot is for a REAL club player photograph, 3:4 portrait. -->
        <div class="player-cell rise" style="--i:1" role="listitem">
          <div class="img-placeholder ratio-3x4" role="img" aria-label="Player photo, supplied by the club">
            <span>Player photo + name &mdash; supplied by the club</span>
          </div>
        </div>
        <!-- AI-IMAGE: none. This slot is for a REAL club player photograph, 3:4 portrait. -->
        <div class="player-cell rise" style="--i:2" role="listitem">
          <div class="img-placeholder ratio-3x4" role="img" aria-label="Player photo, supplied by the club">
            <span>Player photo + name &mdash; supplied by the club</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. CHARITY — the page's only image + text split -->
  <section class="charity" id="charity" aria-labelledby="charity-title">
    <div class="container charity-grid">
      <!-- AI-IMAGE: none. This slot is for a REAL club charity photograph, 4:3. -->
      <div class="img-placeholder ratio-4x3 rise" role="img" aria-label="Charity photo, supplied by the club">
        <span>Charity photo &mdash; supplied by the club</span>
      </div>

      <div class="charity-col">
        <span class="rule" aria-hidden="true"></span>
        <h2 class="section-title rise" id="charity-title">Charity</h2>
        <p class="section-lead rise" style="--i:1">Nothing here is written yet. The club names the programs it wants shown.</p>
        <p class="slot-note rise" style="--i:2">Charity program details go here &mdash; supplied by the club</p>
      </div>
    </div>
  </section>

  <!-- 8. INSIDE THE CLUB — Q21: these two photographs do not exist yet. Not generated. -->
  <section class="inside" aria-labelledby="inside-title">
    <div class="container">
      <div class="section-head">
        <span class="rule" aria-hidden="true"></span>
        <h2 class="section-title rise" id="inside-title">Inside the club</h2>
        <p class="section-lead rise" style="--i:1">Two rooms fans don't usually see. Neither has been photographed yet.</p>
      </div>

      <div class="inside-grid">
        <figure class="inside-fig rise">
          <!-- AI-IMAGE: none. Q21 — to be photographed at the club, 16:9. -->
          <div class="img-placeholder ratio-16x9" role="img" aria-label="Locker room, to be photographed">
            <span>Locker room &mdash; to be photographed</span>
          </div>
          <figcaption>The locker room.</figcaption>
        </figure>

        <figure class="inside-fig rise" style="--i:1">
          <!-- AI-IMAGE: none. Q21 — to be photographed at the club, 16:9. -->
          <div class="img-placeholder ratio-16x9" role="img" aria-label="Training facility, to be photographed">
            <span>Training facility &mdash; to be photographed</span>
          </div>
          <figcaption>The training facility, which the club calls insanely modern.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 9. WHEREVER THE FANS ARE — the service-area analog (Q4). No towns exist; none invented. -->
  <section class="reach" aria-labelledby="reach-title">
    <div class="container">
      <h2 class="reach-title rise" id="reach-title">Wherever the fans are.</h2>
      <p class="reach-text rise" style="--i:1">On TV, on social, and in the stands.</p>
    </div>
  </section>

  <!-- 10. CONTACT / CTA BAND — one intent only: tickets -->
  <section class="cta" id="contact" aria-labelledby="cta-title">
    <div class="container cta-inner">
      <div class="cta-col">
        <h2 class="cta-title rise" id="cta-title">Get tickets.</h2>
        <p class="cta-text rise" style="--i:1">Pre-season, three games, or the full season. Ticket questions go through the ticket team.</p>
      </div>
      <div class="cta-col cta-col-side">
        <a class="btn btn-primary btn-lg rise" href="PLACEHOLDER_TICKET_URL">
          <span>Get Tickets</span><span class="btn-arrow" aria-hidden="true">&#8594;</span>
        </a>
        <ul class="cta-contact rise" style="--i:1" role="list">
          <li>PLACEHOLDER_TICKET_LINE</li>
          <li>PLACEHOLDER_TICKET_EMAIL</li>
        </ul>
      </div>
    </div>
  </section>

</main>

<footer class="site-footer" aria-labelledby="footer-title">
  <h2 class="visually-hidden" id="footer-title">Club information</h2>
  <div class="container footer-grid">

    <div class="footer-brand">
      <img class="footer-mark" src="assets/ny-jets-logo.svg" alt="New York Jets logo" width="296" height="177">
      <a class="btn btn-primary" href="PLACEHOLDER_TICKET_URL">
        <span>Get Tickets</span><span class="btn-arrow" aria-hidden="true">&#8594;</span>
      </a>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <ul role="list">
        <li><a href="#tickets">Tickets</a></li>
        <li><a href="#story">Story</a></li>
        <li><a href="#players">Players</a></li>
        <li><a href="#charity">Charity</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>

    <!-- NAP: name + the two ticket tokens. No address, per Q26. Matches the JSON-LD above. -->
    <div class="footer-nap">
      <p class="footer-name">New York Jets</p>
      <p>PLACEHOLDER_TICKET_LINE</p>
      <p>PLACEHOLDER_TICKET_EMAIL</p>
    </div>

  </div>

  <div class="container footer-legal">
    <p>&copy; 2026 New York Jets.</p>
    <ul role="list">
      <li><a href="PLACEHOLDER_PRIVACY_URL">Privacy</a></li>
      <li><a href="PLACEHOLDER_TERMS_URL">Terms</a></li>
    </ul>
  </div>
</footer>

<p class="demo-note" id="demo-note" role="status" hidden></p>

<script src="main.js"></script>
<script src="film.js"></script>
<script src="splash-cursor.js"></script>
</body>
</html>

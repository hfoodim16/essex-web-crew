# OS / editor
.DS_Store

# Local dev servers, logs
*.log

# Secrets — never commit an API key
.env
*.env
!.env.example

# Per-machine Claude Code settings (the shared ones live in .claude/settings.json)
.claude/settings.local.json

# Scout run state
pipeline/.scout-signal

# Per-run handoff markers teammates drop in a prospect folder — state, not artifacts
prospects/**/.submit
prospects/**/.plan-ready
prospects/**/.outreach-ready

# Python
**/.venv/
**/__pycache__/

# Delivery zips are rebuilt on demand by pipeline/package-site.sh
prospects/**/*.zip

# Keep the prospects scaffold but ignore heavy generated image assets if any land here
prospects/**/*.png
prospects/**/*.jpg
prospects/**/*.jpeg
prospects/**/*.webp
!prospects/**/screenshots/*
# ...but DO track real client logos the builder downloads into a mockup's assets/ —
# these are functional (the site references them), not throwaway generated images.
!prospects/**/mockup/assets/*
# Same goes for the images a work-sample subpage loads from its own folder
# (fora-digital/mockup/work/**) — without these the portfolio pages render broken.
!prospects/**/mockup/work/**/*.png
!prospects/**/mockup/work/**/*.jpg
!prospects/**/mockup/work/**/*.jpeg
!prospects/**/mockup/work/**/*.webp

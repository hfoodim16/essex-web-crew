# OS / editor
.DS_Store

# Local dev servers, logs
*.log

# Delivery zips are rebuilt on demand by pipeline/package-site.sh
prospects/**/*-site.zip

# Keep the prospects scaffold but ignore heavy generated image assets if any land here
prospects/**/*.png
prospects/**/*.jpg
prospects/**/*.jpeg
prospects/**/*.webp
!prospects/**/screenshots/*
# ...but DO track real client logos the builder downloads into a mockup's assets/ —
# these are functional (the site references them), not throwaway generated images.
!prospects/**/mockup/assets/*

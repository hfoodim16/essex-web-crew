# OS / editor
.DS_Store
Thumbs.db
.obsidian/
.vscode/
.idea/

# Local dev servers, logs
*.log

# Node
node_modules/

# Secrets — never commit an API key
.env
*.env
!.env.example

# Per-machine Claude Code settings (the shared ones live in .claude/settings.json)
.claude/settings.local.json

# Scout run state
pipeline/.scout-signal

# Per-run handoff markers teammates drop in a prospect folder — state, not artifacts
prospects/**/.submit
prospects/**/.plan-ready
prospects/**/.outreach-ready

# Python
**/.venv/
**/__pycache__/
*.pyc
.pytest_cache/

# Delivery zips are rebuilt on demand by pipeline/package-site.sh
prospects/**/*.zip

# Keep the prospects scaffold but ignore heavy generated image assets if any land here
prospects/**/*.png
prospects/**/*.jpg
prospects/**/*.jpeg
prospects/**/*.webp
# Screenshots are QA proof, not deliverables — full-page retina captures run 2-6 MB each
# and are regenerable from the mockup at any time. They were tracked until 2026-08-01 and
# had grown to 79 MB, ~77% of the repo. Already-tracked ones stay tracked (git ignores
# .gitignore for files it already knows); this only stops NEW ones from being added.
# Tradeoff: a fresh clone won't carry them, so re-shoot rather than expecting them on pull.
# ...but DO track real client logos the builder downloads into a mockup's assets/ —
# these are functional (the site references them), not throwaway generated images.
!prospects/**/mockup/assets/*
# Same goes for the images a work-sample subpage loads from its own folder
# (fora-digital/mockup/work/**) — without these the portfolio pages render broken.
!prospects/**/mockup/work/**/*.png
!prospects/**/mockup/work/**/*.jpg
!prospects/**/mockup/work/**/*.jpeg
!prospects/**/mockup/work/**/*.webp

# ...except these, which the assets/ exemption above re-admitted by accident: they sit in
# an assets/ folder but no page references them (verified 2026-08-01; cedar-grove's own
# audit.md line 31 calls team.jpg "unreferenced — optional cleanup"). team.jpg alone is a
# 6000x4000 camera original at 5.5 MB. Untracked, but left on disk in case they're wanted.
prospects/cedar-grove-transmission/mockup/assets/team.jpg
prospects/cedar-grove-transmission/mockup/assets/team-sm.webp
prospects/anthonys-landscaping/mockup/assets/original-header-banner.jpg
prospects/happy-trees-by-mgm/mockup/assets/logo-og.png

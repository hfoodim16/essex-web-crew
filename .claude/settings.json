      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-remote:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git check-ignore:*)",
      "Bash(git branch:*)",
